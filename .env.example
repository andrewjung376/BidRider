# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# 공공데이터포털 - 조달청_나라장터 입찰공고정보서비스 (데이터번호 15129394)
DATA_GO_KR_SERVICE_KEY=
KONEPS_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService

# LLM 제공자: claude(기본) | openai
LLM_PROVIDER=claude
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_AGENT=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (서버 전용 키는 api에서만 사용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Vercel Cron 엔드포인트 보호
CRON_SECRET=
