# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# 공공데이터포털 - 조달청_나라장터 입찰공고정보서비스 (데이터번호 15129394)
DATA_GO_KR_SERVICE_KEY=
KONEPS_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService

# LLM 제공자: claude(기본) | openai
LLM_PROVIDER=claude
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_AGENT=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (서버 전용 키는 api에서만 사용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron 엔드포인트 보호
CRON_SECRET=

# ---------------------------------------------------------
# web (Next.js) — Next.js는 web/ 폴더의 .env 파일만 읽는다.
# 아래 값은 web/.env.local에 넣는다. (web/.env.local도 커밋하지 않는다)
# ---------------------------------------------------------
# Supabase 로그인용 (공개 가능 키만, service role 키는 넣지 않는다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# /api/* 프록시 대상. 로컬 http://127.0.0.1:8000, 배포 시 api 프로젝트 URL
API_BASE_URL=http://127.0.0.1:8000
